# Spotify app credentials — create an app at https://developer.spotify.com/dashboard
# (select the "Web API" when asked which APIs you plan to use)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

PORT=3000

# Optional. Leave BASE_URL unset and Ronda uses whatever URL the browser used to
# reach it — so the same server works at http://127.0.0.1:3000 locally AND
# through a tunnel (ngrok, Cloudflare) without editing anything. Set it only to
# pin the public URL, e.g. on a real deployment:
#   BASE_URL=https://ronda.example.com
# BASE_URL=

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Directory for the JSON data store (created automatically, gitignored)
# DATA_DIR=data
