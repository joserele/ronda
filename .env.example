# Spotify app credentials — create an app at https://developer.spotify.com/dashboard
# (select the "Web API" when asked which APIs you plan to use)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where this server is reachable from the browser.
# The Spotify app's Redirect URI must be exactly "$BASE_URL/auth/callback".
# Note: Spotify requires the literal loopback IP (127.0.0.1), not "localhost".
BASE_URL=http://127.0.0.1:3000
PORT=3000

# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Directory for the JSON data store (created automatically, gitignored)
# DATA_DIR=data
